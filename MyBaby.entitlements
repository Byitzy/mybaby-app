<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync and sharing between parents. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes tell the app when the other parent changed something. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets wake-ups and cry alerts break through a Focus that allows time-sensitive notifications. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Shares the database and settings with widgets and the Apple Watch app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
