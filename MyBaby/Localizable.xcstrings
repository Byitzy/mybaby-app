            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "OK to give now" : {
      "comment" : "Medicine dose timing: review with a fluent speaker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puede dar ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut être donné maintenant"
          }
        }
