          }
        }
      }
    },
    "Moving frozen milk to the fridge thaws it: use it within 24 hours, and don't refreeze it (CDC)." : {
      "comment" : "Milk storage safety: translate faithfully",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar leche congelada al refrigerador la descongela: úsala en 24 horas y no la vuelvas a congelar (CDC)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre du lait congelé au réfrigérateur le décongèle : utilisez-le dans les 24 heures et ne le recongelez pas (CDC)."
          }
        }
      }
    },
    "My care" : {
      "comment" : "Title of the parent's private care page",
      "localizations" : {
