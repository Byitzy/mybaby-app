    "RSV antibody (nirsevimab or clesrovimab)" : {
      "comment" : "Vaccine name. Use the official name and abbreviation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anticuerpo contra el VSR (nirsevimab o clesrovimab)"
          }
