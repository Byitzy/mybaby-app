    "How are you doing today? Your check-in takes less than a minute." : {
      "comment" : "Notification body",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo estás hoy? Tu chequeo toma menos de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment allez-vous aujourd'hui ? Votre bilan prend moins d'une minute."
