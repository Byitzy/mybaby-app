    },
    "Times are read in %@, as MyBaby exports them." : {
      "comment" : "Import preview; a time zone's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas se leen en %@, como las exporta MyBaby."
          }
