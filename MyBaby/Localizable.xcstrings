          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six vaccins en une seule injection, pour que votre bébé ait moins de piqûres. Ce contre quoi il protège, et ce à quoi s'attendre ensuite, est pareil que pour chacun d'eux."
          }
        }
      }
