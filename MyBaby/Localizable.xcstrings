    },
    "your night shifts' hours" : {
      "comment" : "Fills the parentheses in “Day and night (…) are worked out separately”",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el horario de tus turnos de noche"
