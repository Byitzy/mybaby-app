    "Diaper check for %@? 🧷" : {
      "comment" : "Diaper reminder title; the baby's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Revisamos el pañal de %@? 🧷"
          }
        },
        "fr" : {
