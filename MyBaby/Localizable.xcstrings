          }
        }
      }
    },
    "Leave an old iPhone or iPad by the crib, plugged in. It listens for crying, can play white noise and a night light, and alerts the parent on duty through your family's own iCloud. Audio never leaves the device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja un iPhone o iPad viejo junto a la cuna, conectado. Escucha el llanto, puede reproducir ruido blanco y una luz de noche, y avisa a quien esté de turno a través del iCloud de tu familia. El audio nunca sale del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez un vieil iPhone ou iPad près du lit de bébé, branché. Il écoute les pleurs, peut faire jouer un bruit blanc et une veilleuse, et alerte le parent de garde par l'iCloud de votre famille. L'audio ne quitte jamais l'appareil."
          }
        }
      }
    },
    "Leave it empty for both sides, or one bottle." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para ambos lados, o un solo recipiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour les deux côtés, ou un seul contenant."
          }
        }
      }
    },
    "Leave it empty for the baby shown in MyBaby." : {
      "localizations" : {
