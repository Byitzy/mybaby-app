    },
    "Night shifts, units, reminders and cry alert settings. Widgets and Live Activities go back to empty, and scheduled reminders are cancelled." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turnos de noche, unidades, recordatorios y ajustes de alertas de llanto. Los widgets y las Live Activities quedan vacíos, y se cancelan los recordatorios programados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarts de nuit, unités, rappels et réglages des alertes de pleurs. Les widgets et les Live Activities redeviennent vides, et les rappels prévus sont annulés."
          }
        }
      }
