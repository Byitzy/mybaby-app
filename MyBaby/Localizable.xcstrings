    "A gentle \"Diaper check?\" when a change is probably due" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un suave «¿Revisar el pañal?» cuando probablemente toque cambiarlo"
