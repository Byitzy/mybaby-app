    },
    "Most apps export times without a time zone. They're read as times in this zone: choose the one you were in when they were logged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las apps exportan las horas sin zona horaria. Se leen como horas de esta zona: elige en la que estabas cuando se registraron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des apps exportent les heures sans fuseau horaire. Elles sont lues comme des heures de ce fuseau : choisissez celui où vous étiez quand elles ont été notées."
          }
        }
      }
    },
    "Moved to the freezer" : {
