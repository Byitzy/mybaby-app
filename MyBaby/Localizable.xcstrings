    },
    "Leave MyBaby running in the background. Don't swipe it away, or listening stops." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja MyBaby abierto en segundo plano. No lo cierres deslizando, o la escucha se detiene."
