    "What %@'s days are like right now" : {
      "comment" : "Diary prompt, with the baby's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo son los días de %@ ahora mismo"
          }
        },
