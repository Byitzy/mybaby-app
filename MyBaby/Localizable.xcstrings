    },
    "Numbers checked %@. If one doesn't work, call your local emergency number." : {
      "comment" : "A date",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Números verificados el %@. Si alguno no funciona, llama al número de emergencias local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numéros vérifiés le %@. Si l'un d'eux ne fonctionne pas, composez le numéro d'urgence local."
          }
        }
      }
    },
    "Nursery monitor" : {
      "comment" : "Subtitle of a cry alert sent by a spare device left by the baby",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor de bebé"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moniteur pour bébé"
          }
        }
      }
    },
    "Nursery monitor (%@)" : {
      "comment" : "The monitor's device name, like \"Noah's iPad\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor de bebé (%@)"
          }
        },
        "fr" : {
