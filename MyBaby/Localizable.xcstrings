    },
    "Events added from other phones stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos agregados desde otros teléfonos se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements ajoutés depuis d'autres téléphones restent."
          }
        }
      }
    },
    "Every baby has their own pace, so there are no target ages here. If you share the log, milestones and their photos are shared too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bebé tiene su propio ritmo, así que aquí no hay edades objetivo. Si compartes el registro, los hitos y sus fotos también se comparten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bébé va à son rythme, alors il n’y a pas d’âge cible ici. Si vous partagez le journal, les étapes et leurs photos sont partagées aussi."
          }
        }
      }
    },
    "Every baby's log" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de cada bebé"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal de chaque bébé"
          }
        }
      }
    },
    "Every few hours" : {
      "comment" : "Feed reminder setting",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pocas horas"
