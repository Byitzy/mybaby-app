    "Photos are saved smaller, without their location, so they sync quickly and stay end-to-end encrypted with the rest of the log." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se guardan más pequeñas, sin su ubicación, para que se sincronicen rápido y sigan cifradas de extremo a extremo con el resto del registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont enregistrées en plus petit, sans leur lieu, pour se synchroniser rapidement et rester chiffrées de bout en bout avec le reste du journal."
          }
        }
      }
    },
    "Pick a moment, or write your own" : {
