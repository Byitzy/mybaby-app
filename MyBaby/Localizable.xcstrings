    "Stop Cry Alerts from Live Activity" : {
      "comment" : "App Intent title, hidden from Shortcuts: the listening Live Activity's Stop button (Shared/ButtonIntents.swift)",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
