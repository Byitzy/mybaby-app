    "Enter the timing exactly as your pediatrician directed. MyBaby never suggests a dose or how often to give it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa el intervalo exactamente como lo indicó tu pediatra. MyBaby nunca sugiere una dosis ni cada cuánto darla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez le délai exactement comme votre pédiatre l'a indiqué. MyBaby ne suggère jamais de dose ni à quelle fréquence la donner."
          }
        }
      }
    },
    "Entries already in MyBaby aren't added twice, so importing the same file again is safe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas que ya están en MyBaby no se agregan dos veces, así que importar el mismo archivo de nuevo es seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées déjà dans MyBaby ne sont pas ajoutées deux fois : vous pouvez donc importer le même fichier de nouveau sans risque."
          }
        }
      }
    },
    "Entries logged in it stay. Reports go back to working this time out from the log." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas registradas en ese tiempo se quedan. Informes vuelve a calcular este tiempo a partir del registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées notées pendant cette période restent. Rapports recalcule cette période à partir du journal."
          }
        }
      }
    },
