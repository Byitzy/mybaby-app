    "Born at %@, so the percentiles use corrected age, counted from the due date, until %@'s second birthday. %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nació con %1$@ de gestación, así que los percentiles usan la edad corregida, contada desde la fecha probable de parto, hasta el segundo cumpleaños de %2$@. %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naissance à %@, donc les percentiles utilisent l'âge corrigé, compté à partir de la date prévue d'accouchement, jusqu'au deuxième anniversaire de %@. %@"
          }
        }
      }
    },
    "Born early, so growth percentiles use corrected age, counted from the due date (%@), until %@'s second birthday, as pediatricians usually do." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como nació antes de tiempo, los percentiles de crecimiento usan la edad corregida, contada desde la fecha probable de parto (%1$@), hasta el segundo cumpleaños de %2$@, como suelen hacer los pediatras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La naissance étant prématurée, les percentiles de croissance utilisent l’âge corrigé, compté à partir de la date prévue (%1$@), jusqu’au deuxième anniversaire de %2$@, comme le font habituellement les pédiatres."
          }
        }
      }
    },
