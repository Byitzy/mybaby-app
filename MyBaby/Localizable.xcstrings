    "Recommended routine vaccines. Your country's health ministry has its own schedule." : {
      "comment" : "Vaccine guide: what the linked page is",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacunas de rutina recomendadas. El ministerio de salud de tu país tiene su propio calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaccins systématiques recommandés. Le ministère de la Santé de votre pays a son propre calendrier."
          }
        }
      }
    },
    "Recommended schedules, for parents (HealthyChildren.org)" : {
      "comment" : "Vaccine guide: what the linked page is",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendarios recomendados, para madres y padres (HealthyChildren.org, en inglés)"
          }
        },
