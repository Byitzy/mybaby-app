    "Send feedback" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar comentarios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer des commentaires"
          }
        }
      }
    },
    "Send feedback fills in an email from your own account. Only you can send it, after seeing everything in it. The optional technical details never include names, dates or anything from your log. Crash reports from iOS stay on this iPhone unless you attach one, and are deleted after 30 days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar comentarios prepara un correo desde tu propia cuenta. Solo tú puedes enviarlo, después de ver todo lo que contiene. Los detalles técnicos opcionales nunca incluyen nombres, fechas ni nada de tu registro. Los informes de fallos de iOS se quedan en este iPhone a menos que adjuntes uno, y se eliminan después de 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer des commentaires prépare un courriel depuis votre propre compte. Personne d'autre que vous ne peut l'envoyer, après avoir vu tout son contenu. Les détails techniques facultatifs n'incluent jamais de noms, de dates ni rien de votre journal. Les rapports de plantage d'iOS restent sur cet iPhone, sauf si vous en joignez un, et sont supprimés après 30 jours."
          }
        }
      }
    },
