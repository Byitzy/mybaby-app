    "Soreness, a low fever, fussiness and extra sleep are common for a day or two after shots." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dolor, la fiebre baja, la irritabilidad y dormir más son comunes durante uno o dos días después de las vacunas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sensibilité, une légère fièvre, de l'irritabilité et plus de sommeil sont fréquents pendant un jour ou deux après les vaccins."
          }
        }
      }
    },
    "Soreness, redness or swelling where the shot was given" : {
      "comment" : "Vaccine guide: a common reaction",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
