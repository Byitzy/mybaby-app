    "Fever, more often than after other baby vaccines" : {
      "comment" : "Vaccine guide: a common reaction",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiebre, con más frecuencia que después de otras vacunas para bebés"
