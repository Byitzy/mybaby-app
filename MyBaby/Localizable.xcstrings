    "Red, black (after the first few days) or white/pale poop can be a sign to call your pediatrician." : {
      "comment" : "Medical: review with a fluent speaker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una popó roja, negra (después de los primeros días) o blanca/pálida puede ser señal de que debes llamar a tu pediatra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des selles rouges, noires (après les premiers jours) ou blanches/pâles peuvent être un signe qu'il faut appeler votre pédiatre."
          }
        }
      }
    },
    "Redness or soreness where the shot was given that gets worse after a day." : {
      "comment" : "Vaccine guide: when to call the doctor",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrojecimiento o dolor en el sitio de la inyección que empeora después de un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une rougeur ou une douleur à l'endroit de l'injection qui s'aggrave après un jour."
          }
        }
      }
    },
    "Redness, warmth or swelling where the shot was given" : {
