          }
        }
      }
    },
    "Fever: 100.4 °F (38 °C) or higher rectal, ear or forehead; 100 °F (37.8 °C) by mouth; 99 °F (37.2 °C) under the arm (AAP)." : {
      "comment" : "Medical thresholds from the American Academy of Pediatrics; keep every number",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiebre: 100.4 °F (38 °C) o más por vía rectal, en el oído o en la frente; 100 °F (37.8 °C) por vía oral; 99 °F (37.2 °C) en la axila (AAP)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fièvre : 100,4 °F (38 °C) ou plus par voie rectale, dans l'oreille ou sur le front ; 100 °F (37,8 °C) par la bouche ; 99 °F (37,2 °C) sous le bras (AAP)."
          }
        }
      }
    },
