      }
    },
    "Whoever is on duty" : {
      "comment" : "Who gets buzzed",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien esté de turno"
          }
        },
        "fr" : {
