    },
    "2 or 3 doses in the first months, starting around 6 to 8 weeks." : {
      "comment" : "Vaccine guide: when the rotavirus vaccine is usually given",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 o 3 dosis en los primeros meses, a partir de las 6 a 8 semanas aproximadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 ou 3 doses dans les premiers mois, à partir d'environ 6 à 8 semaines."
          }
        }
      }
    },
    "2 or 3 doses in the first year, and a booster around the first birthday." : {
      "comment" : "Vaccine guide: when the pneumococcal vaccine is usually given",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 o 3 dosis en el primer año y un refuerzo alrededor del primer cumpleaños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 ou 3 doses dans la première année, et un rappel vers le premier anniversaire."
          }
        }
