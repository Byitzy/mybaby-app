    "Fever and a mild rash, usually 1 to 2 weeks after the shot" : {
      "comment" : "Vaccine guide: a common reaction",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiebre y un sarpullido leve, por lo general de 1 a 2 semanas después de la inyección"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la fièvre et une légère éruption cutanée, généralement 1 à 2 semaines après l'injection"
          }
        }
      }
    },
    "Fever and a mild rash, usually 1 to 2 weeks after the shot. The rash isn't contagious." : {
      "comment" : "Vaccine guide: a common reaction",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiebre y un sarpullido leve, por lo general de 1 a 2 semanas después de la inyección. El sarpullido no es contagioso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la fièvre et une légère éruption cutanée, généralement 1 à 2 semaines après l'injection. L'éruption n'est pas contagieuse."
          }
        }
      }
    },
