            "state" : "translated",
            "value" : "Tendances"
          }
        }
      }
    },
    "Patterns describe what was logged, not what's expected. Every baby is different. If something worries you, talk to your pediatrician." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los patrones describen lo que se registró, no lo que se espera. Cada bebé es distinto. Si algo te preocupa, habla con tu pediatra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances décrivent ce qui a été noté, pas ce qui est attendu. Chaque bébé est différent. Si quelque chose vous inquiète, parlez-en à votre pédiatre."
          }
        }
      }
    },
    "Pause" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause"
          }
        }
      }
