        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au calendrier est restreint"
          }
        }
      }
    },
    "Calendar events are stored by your calendar's provider (such as iCloud, Google or Outlook), outside MyBaby's end-to-end encryption. Notes and questions aren't copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos de calendario los guarda el proveedor de tu calendario (como iCloud, Google u Outlook), fuera del cifrado de extremo a extremo de MyBaby. Las notas y las preguntas no se copian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements de calendrier sont stockés par le fournisseur de votre calendrier (comme iCloud, Google ou Outlook), en dehors du chiffrement de bout en bout de MyBaby. Les notes et les questions ne sont pas copiées."
          }
        }
      }
    },
