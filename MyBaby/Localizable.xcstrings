          }
        }
      }
    },
    "Percentiles use age from the birthday. For a baby born early, add the weeks of pregnancy in the baby's profile to use corrected age." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los percentiles usan la edad desde el día del nacimiento. Para un bebé que nació antes de tiempo, agrega las semanas de embarazo en el perfil del bebé para usar la edad corregida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les percentiles utilisent l'âge à partir de la date de naissance. Pour un bébé né prématurément, ajoutez les semaines de grossesse dans le profil du bébé pour utiliser l'âge corrigé."
          }
        }
      }
