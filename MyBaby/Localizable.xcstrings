          }
        }
      }
    },
    "A gentle note at %@ each time %@ turns another month old: %@ Only on this iPhone." : {
      "comment" : "The third value is the reminder's words, in quotes",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso suave a las %1$@ cada vez que %2$@ cumple un mes más: %3$@ Solo en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit mot à %1$@ chaque fois que %2$@ a un mois de plus : %3$@ Seulement sur cet iPhone."
          }
        }
      }
    },
    "A gentle nudge once a day. The notification only says it's time to check in, never how you've been feeling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio suave una vez al día. La notificación solo dice que es hora de tu chequeo, nunca cómo te has sentido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit rappel une fois par jour. La notification dit seulement que c'est le moment de faire votre bilan, jamais comment vous vous sentez."
          }
        }
      }
    },
    "a letter" : {
      "comment" : "Siri synonym",
      "localizations" : {
