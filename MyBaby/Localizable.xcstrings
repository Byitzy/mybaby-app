    "Totals only count what was logged. Days that weren't logged aren't counted as zero, and averages use fully logged days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales solo cuentan lo registrado. Los días sin registros no cuentan como cero, y los promedios usan los días registrados por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux ne comptent que ce qui a été noté. Les jours non notés ne comptent pas comme zéro, et les moyennes utilisent les jours entièrement notés."
          }
        }
      }
    },
    "Track vitamin D drops, fever reducers and prescriptions so you always know when the last dose was given." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el control de las gotas de vitamina D, los medicamentos para la fiebre y las recetas para saber siempre cuándo se dio la última dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les gouttes de vitamine D, les médicaments contre la fièvre et les ordonnances pour toujours savoir quand la dernière dose a été donnée."
          }
        }
      }
    },
