    "Each baby has their own log. Switch between them by tapping the name on Today." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bebé tiene su propio registro. Cambia entre ellos tocando el nombre en Hoy."
