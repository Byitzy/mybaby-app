    "Low Power Mode is on: listening uses a little less battery, and a soft cry may take a moment longer to notice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado: escuchar usa un poco menos de batería, y un llanto suave puede tardar un poco más en notarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Économie d'énergie est activé : l'écoute utilise un peu moins de batterie, et un pleur léger peut prendre un peu plus de temps à être remarqué."
          }
        }
      }
    },
    "Made with MyBaby on %@" : {
      "localizations" : {
