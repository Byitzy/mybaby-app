    },
    "%@ was %lld days ago" : {
      "comment" : "A short vaccine name (or a list of them), then 3 or more days. Rephrased as “MMR: 9 days ago” so it agrees with one name or several.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: hace %2$lld días"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : il y a %2$lld jours"
          }
        }
      }
    },
    "%@ were %lld days ago" : {
      "comment" : "Several short vaccine names, then 3 or more days.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: hace %2$lld días"
          }
        },
