    "Calendar access is off for MyBaby, so they would stay in your calendar. To remove them, first allow full calendar access for MyBaby in the Settings app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al calendario está desactivado para MyBaby, así que se quedarían en tu calendario. Para quitarlas, primero permite el acceso total al calendario para MyBaby en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au calendrier est désactivé pour MyBaby, donc ils resteraient dans votre calendrier. Pour les retirer, autorisez d'abord l'accès complet au calendrier pour MyBaby dans l'app Réglages."
          }
        }
      }
    },
    "Calendar access is restricted" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
