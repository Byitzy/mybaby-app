            "state" : "translated",
            "value" : "Vous pouvez voir cette allergie, mais seuls les parents peuvent enregistrer des modifications."
          }
        }
      }
    },
    "You can see this appointment, but only the parents can save changes." : {
      "localizations" : {
        "es" : {
