    "Hepatitis A (HepA)" : {
      "comment" : "Vaccine name. Use the official name and abbreviation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hepatitis A (HA)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hépatite A (HA)"
          }
        }
      }
    },
    "Hepatitis A, a liver infection spread through food, water and close contact" : {
      "comment" : "Vaccine guide: what the vaccine protects against",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hepatitis A, una infección del hígado que se transmite por los alimentos, el agua y el contacto cercano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hépatite A, une infection du foie transmise par les aliments, l'eau et les contacts étroits"
          }
        }
      }
    },
    "Hepatitis B (HepB)" : {
      "comment" : "Vaccine name. Use the official name and abbreviation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hepatitis B (HB)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hépatite B (HB)"
          }
        }
      }
    },
    "Hepatitis B can pass to a baby at birth or later through blood. Babies who catch it usually keep it for life, and it can damage the liver over the years." : {
      "comment" : "Vaccine guide: about hepatitis B",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hepatitis B se puede transmitir a un bebé al nacer o más tarde a través de la sangre. Los bebés que se contagian suelen tenerla de por vida, y con los años puede dañar el hígado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hépatite B peut se transmettre à un bébé à la naissance ou plus tard par le sang. Les bébés qui l'attrapent la gardent généralement toute leur vie, et elle peut abîmer le foie au fil des ans."
          }
        }
      }
    },
    "Hepatitis B, a virus that infects the liver" : {
      "comment" : "Vaccine guide: what the vaccine protects against",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hepatitis B, un virus que infecta el hígado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hépatite B, un virus qui infecte le foie"
          }
        }
      }
    },
