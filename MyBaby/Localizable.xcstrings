          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora de nacimiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heure de naissance"
          }
        }
      }
    },
    "Time since" : {
      "comment" : "Header over the time-since-last cards on iPad",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo transcurrido"
