    "An entry of the same kind within a minute of one already in MyBaby is treated as the same one and skipped." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una entrada del mismo tipo a menos de un minuto de otra que ya está en MyBaby se considera la misma y se omite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une entrée du même genre à moins d'une minute d'une entrée déjà dans MyBaby est considérée comme la même et ignorée."
          }
        }
      }
    },
    "An event you added with Add to Calendar wasn't in your calendar any more, so it was probably deleted or changed there already: %@. If you still see it, you can delete it in the Calendar app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un evento que agregaste con Agregar al calendario ya no estaba en tu calendario, así que probablemente ya se eliminó o cambió allí: %@. Si todavía lo ves, puedes eliminarlo en la app Calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un événement que vous avez ajouté avec « Ajouter au calendrier » n'était plus dans votre calendrier, alors il y a sans doute déjà été supprimé ou modifié : %@. Si vous le voyez encore, vous pouvez le supprimer dans l'app Calendrier."
          }
        }
      }
    },
