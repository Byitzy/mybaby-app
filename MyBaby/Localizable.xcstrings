      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se terminó de eliminar tu copia de iCloud, así que la sincronización con iCloud está desactivada y tu registro está solo en este iPhone. Toca Terminar de eliminar la copia de iCloud para intentarlo de nuevo. Activar la sincronización primero la termina."
          }
        },
        "fr" : {
