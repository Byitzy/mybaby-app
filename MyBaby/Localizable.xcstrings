        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail n'a pas pu envoyer le courriel. Veuillez réessayer."
          }
        }
      }
    },
    "Mail isn't set up on this iPhone. Open in email app starts the message in another email app, or copy it and send it to %@ from any email app." : {
      "comment" : "An email address",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail no está configurado en este iPhone. Abrir en la app de correo empieza el mensaje en otra app de correo, o cópialo y envíalo a %@ desde cualquier app de correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail n'est pas configuré sur cet iPhone. Ouvrir dans l'app de courriel commence le message dans une autre app de courriel, ou copiez-le et envoyez-le à %@ depuis n'importe quelle app de courriel."
          }
        }
      }
    },
    "Mail opens with everything filled in, to %@. You can change anything there before you tap Send." : {
      "comment" : "An email address",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail se abre con todo listo, para %@. Puedes cambiar lo que quieras antes de tocar Enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail s'ouvre avec tout déjà rempli, à l'adresse %@. Vous pouvez tout modifier avant de toucher Envoyer."
          }
        }
      }
    },
