    },
    "You agreed on %@." : {
      "comment" : "A date and time",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptaste el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
