        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures sont lues dans le fuseau %@, comme MyBaby les exporte."
          }
        }
      }
    },
    "Times that weren't logged in the other app stay unlogged in MyBaby. They're not counted as nothing happening." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los periodos que no se registraron en la otra app siguen sin registrar en MyBaby. No se cuentan como que no pasó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les périodes non notées dans l'autre app restent non notées dans MyBaby. Elles ne sont pas comptées comme des moments où rien ne s'est passé."
          }
        }
      }
    },
    "Title (optional)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
